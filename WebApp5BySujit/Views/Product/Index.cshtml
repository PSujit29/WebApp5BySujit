@{
}
@model IEnumerable<WebApp5BySujit.Models.Product>

<div class="mt-3">
    <div class="mb-2">
        <a href="/Product/Create" class="btn btn-primary btn-sm">Add Product</a>
    </div>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Name</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Price</td>
                    <td>
                        <a href="/Product/Edit/@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a href="/Product/Delete/@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>